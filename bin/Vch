import sys
import os
import glob
import optparse
#import numpy as np

#import re
#from copy import deepcopy

import StructureAnalysisEnvironment as SAEnv
#import SpaceGroupEnvironment as SGE

################################################################################
def options():

    parser = optparse.OptionParser()
    parser.add_option( '-i','--input', dest='INPUT',)
    parser.add_option( '-o','--output', dest='OUTPUT',)
    parser.add_option( '-v','--vacuum')
    options,  args = parser.parse_args()


################################################################################
if __name__ == '__main__':

    if not os.path.exists('INCAR'): sys.exit("STOP: INCAR not found")
    if not os.path.exists('KPOINTS'): sys.exit("STOP: KPOINTS not found")
    if not os.path.exists('POSCAR'): sys.exit("STOP: POSCAR not found")
    if not os.path.exists('POTCAR'): sys.exit("STOP: POTCAR not found")

    incar = SAEnv.ReadVaspIncar()
    poscar = SAEnv.ReadVaspPoscar()
    potcar = SAEnv.ReadVaspPotcar()

    if incar.ispin > 1:
        print ""
        print "ISPIN  =",incar.ispin

    print "GGA    =",incar.gga
    print ""
    print "ISMEAR =",incar.ismear
    print "SIGMA  =",incar.sigma
    if incar.nbands is not None:
        print "NBANDS = ",incar.nbands

    print ""
    print "NELM   = ",incar.nelm
    print "NSW    = ",incar.nsw


    if incar.nsw > 0:
        print "IBRION = ",incar.ibrion

    print "EDIFF  = ",incar.ediff
    print "EDIFFG = ",incar.ediffg


    kpoints = SAEnv.ReadVaspKpoints()
    kx,ky,kz = kpoints.get_kpoints()
    print ""
    print "Kx     = ",kx
    print "Ky     = ",ky
    print "Kz     = ",kz

    if incar.nsw > 0:
        poscar.get_selective()
        print ""
        if poscar.selective:
            print "Selective Dynamics"
        else:
            print "non Selective Dynamics"

    if incar.isym != 1:
        print ""
        print "ISYM   = ",incar.isym

    if incar.laechg:
        print ""
        print "LAECHG = ",incar.laechg
        print "NGXF   = ",incar.ngxf
        print "NGYF   = ",incar.ngyf
        print "NGZF   = ",incar.ngzf

    print ""
    print "NPAR   = ",incar.npar

    print ""
    print "---- POSCAR ----"
    print "",
    for i in range(len(poscar.atoms_index)):
        print poscar.atoms_index[i]+" ",
    print ""
    print "",
    for i in range(len(poscar.atoms)):
        print str(poscar.atoms[i])+" ",
    print ""

    print ""
    print "---- POTCAR ----"
    print "",
    for i in range(len(poscar.atoms_index)):
        print potcar.atoms_index[i]+" ",
    print ""
    print " (zval)"
    print "",
    for i in range(len(potcar.atoms_zval)):
        print str(potcar.atoms_zval[i])+" ",
    print ""


